# Scenario used by the judge eval. baseline | benign | broken
# Inlined by Metro at bundle time, so switching it needs a reload but never a native rebuild.
EXPO_PUBLIC_ROUTESHOT_SCENARIO=baseline

# Optional. With a key here, `routeshot capture --judge` asks Anthropic directly. Without one it
# asks the hosted report server in routeshot.config.ts, which holds a key for this demo.
ANTHROPIC_API_KEY=
