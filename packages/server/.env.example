# Postgres connection string. Railway injects this when a Postgres service is attached.
# Required in production. Leave it empty locally to run on in-memory storage (nothing persists).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/routeshot

# Shared bearer token for the repo. The CLI sends it as `Authorization: Bearer <token>`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ROUTESHOT_TOKEN=change-me

# Leave empty to run without the AI verdict: reports still ship, changed routes have no verdict.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# score >= JUDGE_YELLOW is yellow, score >= JUDGE_RED is red, defect "none" caps at yellow.
JUDGE_YELLOW=40
JUDGE_RED=75

# Judge calls allowed per UTC day across every compare. Over the cap, routes come back unverified.
JUDGE_DAILY_CAP=500

# Compare requests allowed per token per minute.
COMPARE_RATE_LIMIT=60

PORT=3000
